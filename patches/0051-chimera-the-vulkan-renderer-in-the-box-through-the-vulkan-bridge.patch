+#if defined(CHIMERA_CORE)
+	void memory_block::chimera_flush(u64 offset, u64 size)
+	{
+		if (offset >= m_size) return;
+		VkMappedMemoryRange range{};
+		range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+		range.memory = get_vk_device_memory();
+		range.offset = get_vk_device_memory_offset() + offset;
+		range.size = std::min<u64>(size, m_size - offset);
+		vkFlushMappedMemoryRanges(m_device, 1, &range);
+	}
+
+	void memory_block::chimera_invalidate(u64 offset, u64 size)
+	{
+		if (offset >= m_size) return;
+		VkMappedMemoryRange range{};
+		range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+		range.memory = get_vk_device_memory();
+		range.offset = get_vk_device_memory_offset() + offset;
+		range.size = std::min<u64>(size, m_size - offset);
+		vkInvalidateMappedMemoryRanges(m_device, 1, &range);
+	}
+#endif
+
 	void* memory_block::map(u64 offset, u64 size)
 	{
+#if defined(CHIMERA_CORE)
+		// chimera: see memory.h. The allocator keeps a block mapped while any
+		// allocation in it is, so making this mapping may fetch nothing: the
+		// range is fetched here, and sent again when it is unmapped.
+		void* const ptr = m_mem_allocator->map(m_mem_handle, offset, size);
+		m_chimera_map_offset = offset;
+		m_chimera_map_size = size;
+		chimera_invalidate(offset, size);
+		return ptr;
+#else
 		return m_mem_allocator->map(m_mem_handle, offset, size);
+#endif
 	}
 
 	void memory_block::unmap()
 	{
+#if defined(CHIMERA_CORE)
+		chimera_flush(m_chimera_map_offset, m_chimera_map_size);
+#endif
 		m_mem_allocator->unmap(m_mem_handle);
 	}
 }
