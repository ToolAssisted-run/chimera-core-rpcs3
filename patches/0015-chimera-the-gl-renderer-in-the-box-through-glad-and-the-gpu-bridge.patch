diff --git a/rpcs3/Emu/RSX/GL/OpenGL.cpp b/rpcs3/Emu/RSX/GL/OpenGL.cpp
index 7381eb990..24aca916d 100644
--- a/rpcs3/Emu/RSX/GL/OpenGL.cpp
+++ b/rpcs3/Emu/RSX/GL/OpenGL.cpp
@@ -24,8 +24,25 @@ extern "C"
 #undef WGL_PROC
 #endif
 
+#ifdef CHIMERA_CORE
+// the bridge's lookup: a generated wrapper per entry point, or a stub that
+// names the caller if the renderer ever reaches a name nobody bridged
+extern "C" void* chimera_gl_lookup_or_trap(const char* name);
+static GLADapiproc chimera_glad_load(void* /*userptr*/, const char* name)
+{
+	return reinterpret_cast<GLADapiproc>(chimera_gl_lookup_or_trap(name));
+}
+#endif
+
 void gl::init()
 {
+#ifdef CHIMERA_CORE
+	if (!gladLoadGLUserPtr(chimera_glad_load, nullptr))
+	{
+		rsx_log.fatal("OpenGL: glad could not load through the GPU bridge");
+	}
+	return;
+#endif
 #ifdef _WIN32
 #define OPENGL_PROC(p, n) OPENGL_PROC2(p, gl##n, gl##n)
 #define WGL_PROC(p, n) OPENGL_PROC2(p, wgl##n, wgl##n)
@@ -35,7 +52,7 @@ void gl::init()
 #undef WGL_PROC
 #undef OPENGL_PROC2
 #endif
-#ifdef __unix__
+#if defined(__unix__) && !defined(CHIMERA_CORE)
 	glewExperimental = true;
 	glewInit();
 #endif
@@ -43,6 +60,10 @@ void gl::init()
 
 void gl::set_swapinterval(int interval)
 {
+#ifdef CHIMERA_CORE
+	// no window, no swap chain: the frontend paces the machine
+	return;
+#endif
 #ifdef _WIN32
 	wglSwapIntervalEXT(interval);
 #elif defined(HAVE_X11)
