  "firmware": [
    {
      "id": "PS3UPDAT.PUP",
      "display": "PlayStation 3 System Software",
      "description": "Sony's own PS3 system software update, PS3UPDAT.PUP, the file Sony distributes for the console (version 4.80 or newer). The machine decrypts it into its flash at boot, before the first frame, the way a console holds its firmware: the LLE system libraries games link against come from it. Homebrew that only uses lv2 syscalls boots without it; anything real needs it - a disc game and a digital-only title's package alike. Two projects on different versions are different machines and do not share movies.",
      "name": "PS3UPDAT.PUP",
      "requiredWhen": {
        "any": [
          {
            "slot": "game",
            "extension": "iso"
          },
          {
            "slot": "game",
            "extension": "pkg"
          }
        ]
      }
    }
  ],
  "engineAssetsNote": "none: the firmware is the user's and the emulator ships no data files of its own for a PS3",
  "precompile": true,
  "_precompile_note": "This core can fill its compile cache without running (SetPrecompile): the frontend runs several precompile sessions side by side before a project first boots, with a progress bar, so the LLVM recompiler starts warm.",
  "suggestSettings": true,
  "_suggestSettings_note": "SuggestSettings looks the game up in the RPCS3 wiki's per-game recommendations this core carries (wiki-compat.json) without booting it: the new-project wizard applies them on its settings page and shows where they come from, or that the game is not there."
}
