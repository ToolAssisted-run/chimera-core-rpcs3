{
  "_comment": "This file lists the kinds of file a project of this core can hold. Chimera's New Project window is built from it. A PS3 project is one game. It can be a homebrew executable that is started directly, a disc image, a copied disc folder packed as one .zip, or the .pkg of a title sold only as a download, which is installed on the console's hard disk and started from there.",
  "slots": [
    {
      "id": "game",
      "title": "slot.game",
      "min": 1,
      "max": 1,
      "formats": [
        "elf",
        "self",
        "bin",
        "iso",
        "zip",
        "7z",
        "pkg"
      ],
      "help": "slot.game.help"
    },
    {
      "id": "dkey",
      "title": "slot.dkey",
      "min": 0,
      "max": 1,
      "formats": [
        "dkey",
        "key"
      ],
      "help": "slot.dkey.help",
      "exposedWhen": {
        "not": {
          "slot": "game",
          "extension": "pkg"
        }
      }
    },
    {
      "id": "pkg",
      "title": "slot.pkg",
      "min": 0,
      "max": -1,
      "formats": [
        "pkg"
      ],
      "help": "slot.pkg.help"
    },
    {
      "id": "rap",
      "title": "slot.rap",
      "min": 0,
      "max": -1,
      "formats": [
        "rap"
      ],
      "namePattern": "^[A-Za-z0-9_\\-]{1,48}\\.rap$",
      "nameHelp": "slot.rap.name_help",
      "help": "slot.rap.help"
    },
    {
      "id": "savedata",
      "title": "slot.savedata",
      "min": 0,
      "max": 1,
      "formats": [
        "zip"
      ],
      "help": "slot.savedata.help"
    }
  ]
}
