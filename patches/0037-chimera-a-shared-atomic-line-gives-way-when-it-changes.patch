@@ -95,6 +95,10 @@
 	// Reservation stats
 	alignas(4096) u8 g_reservations[65536 / 128 * 64]{0};
 
+	// Chimera: the CPU that last completed a conditional store on each slot
+	// (vm_reservation.h: reservation_cpu_alternated)
+	u32 g_reservation_last_cpu[65536 / 128]{0};
+
 	// Pointers to shared memory mirror or zeros for "normal" memory
 	alignas(4096) atomic_t<u64> g_shmem[65536]{0};
 
@@ -2303,6 +2307,7 @@
 			};
 
 			std::memset(g_reservations, 0, sizeof(g_reservations));
+			std::memset(g_reservation_last_cpu, 0, sizeof(g_reservation_last_cpu));
 			std::memset(g_shmem, 0, sizeof(g_shmem));
 			std::memset(g_range_lock_set, 0, sizeof(g_range_lock_set));
 			std::memset(g_range_lock_bits, 0, sizeof(g_range_lock_bits));
