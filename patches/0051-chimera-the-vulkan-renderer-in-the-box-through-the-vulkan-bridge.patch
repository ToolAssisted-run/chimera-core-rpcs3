+// The buffer the pixels cross through, in both directions. Made with the
+// plain calls and not by the allocator: it is mapped whole for as long as it
+// lives, and a mapping is a copy the bridge keeps of all the memory it is in.
+bool VKGSRender::chimera_stage_ready()
+{
+	if (m_chimera_stage_ptr)
+	{
+		return true;
+	}
+
+	const VkDevice dev = *m_device;
+	VkBufferCreateInfo info = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+	info.size = chimera_stage_bytes;
+	info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+	info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	if (vkCreateBuffer(dev, &info, nullptr, &m_chimera_stage) != VK_SUCCESS)
+	{
+		m_chimera_stage = VK_NULL_HANDLE;
+		return false;
+	}
+
+	VkMemoryRequirements req{};
+	vkGetBufferMemoryRequirements(dev, m_chimera_stage, &req);
+
+	// A type the host can see, a cached one for choice: this is read far more
+	// than it is written
+	const auto& props = m_device->gpu().get_memory_properties();
+	u32 type = umax;
+	for (u32 pass = 0; pass < 2 && type == umax; pass++)
+	{
+		for (u32 i = 0; i < props.memoryTypeCount; i++)
+		{
+			const auto flags = props.memoryTypes[i].propertyFlags;
+			if ((req.memoryTypeBits & (1u << i)) && (flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) &&
+				(pass == 1 || (flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT)))
+			{
+				type = i;
+				break;
+			}
+		}
+	}
+
+	VkMemoryAllocateInfo alloc = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+	alloc.allocationSize = req.size;
+	alloc.memoryTypeIndex = type;
+	void* ptr = nullptr;
+	if (type == umax ||
+		vkAllocateMemory(dev, &alloc, nullptr, &m_chimera_stage_memory) != VK_SUCCESS ||
+		vkBindBufferMemory(dev, m_chimera_stage, m_chimera_stage_memory, 0) != VK_SUCCESS ||
+		vkMapMemory(dev, m_chimera_stage_memory, 0, VK_WHOLE_SIZE, 0, &ptr) != VK_SUCCESS || !ptr)
+	{
+		rsx_log.error("chimera: no buffer for the render targets' pixels; a load will lose them");
+		chimera_stage_release();
+		return false;
+	}
+
+	m_chimera_stage_ptr = static_cast<u8*>(ptr);
+	m_chimera_stage_size = chimera_stage_bytes;
+	return true;
+}
+
+void VKGSRender::chimera_stage_release()
+{
+	if (m_chimera_stage)
+	{
+		vkDestroyBuffer(*m_device, m_chimera_stage, nullptr);
+	}
+
+	if (m_chimera_stage_memory)
+	{
+		vkFreeMemory(*m_device, m_chimera_stage_memory, nullptr);
+	}
+
+	m_chimera_stage = VK_NULL_HANDLE;
+	m_chimera_stage_memory = VK_NULL_HANDLE;
+	m_chimera_stage_ptr = nullptr;
+	m_chimera_stage_size = 0;
+}
+
+void VKGSRender::chimera_shadow_surfaces()
+{
+	if (m_device == VK_NULL_HANDLE)
+	{
+		return;
+	}
+
+	// A state taken straight after a load, before a frame has run: the
+	// surfaces still name the images of the device that is gone, so there is
+	// nothing to read - and nothing to do, because the block came with the
+	// state that was loaded and describes exactly this machine.
+	if (const u64 live = chimera_rpcs3_vulkan_context(); live != 0 && live != m_chimera_vk_device)
+	{
+		return;
+	}
+
+	chimera_rsx_shadow_set_current(0);
+
+	u8* shadow = nullptr;
+	u64 shadow_size = 0;
+	chimera_rsx_shadow_block(&shadow, &shadow_size);
+	if (!shadow || shadow_size <= chimera_shadow_data_at)
+	{
+		return;
+	}
+
+	// This runs with the RSX thread stopped wherever the frame's end found
+	// it. Its command buffer is handed in below, which it can be from most
+	// places - but not from inside the handing in itself, and not before
+	// there is one. A state taken then carries no copies, and a load of it
+	// brings the surfaces back empty.
+	if (m_chimera_vk_rebuilding || !m_current_command_buffer || !m_current_command_buffer->is_recording() ||
+		(m_queue_status & flush_queue_state::flushing) || !chimera_stage_ready())
+	{
+		return;
+	}
+
+	auto head = reinterpret_cast<chimera_shadow_header*>(shadow);
+	auto table = reinterpret_cast<chimera_shadow_record*>(head + 1);
+
+	// Copies are commands, and none may be given inside a render pass. The
+	// renderer opens its pass again before it next draws.
+	if (vk::is_renderpass_open(*m_current_command_buffer))
+	{
+		close_render_pass();
+	}
+
+	struct pending_t { u64 stage_at; u64 shadow_at; u64 bytes; };
+	std::array<pending_t, 64> pending;
+	u32 pending_count = 0;
+	u64 used = 0;
+
+	// What has been asked for is waited for and compared with the copy
+	// already held. Only what differs is written: a page that is not written
+	// is not in the next delta.
+	const auto run_batch = [&]()
+	{
+		if (!pending_count)
+		{
+			return;
+		}
+
+		flush_command_queue(true, true);
+
+		VkMappedMemoryRange range = { .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE };
+		range.memory = m_chimera_stage_memory;
+		range.size = std::min<u64>((used + 4095) & ~u64{4095}, m_chimera_stage_size);
+		vkInvalidateMappedMemoryRanges(*m_device, 1, &range);
+
+		for (u32 i = 0; i < pending_count; i++)
+		{
+			u8* const kept = shadow + pending[i].shadow_at;
+			const u8* const now = m_chimera_stage_ptr + pending[i].stage_at;
+			if (std::memcmp(kept, now, pending[i].bytes) != 0)
+			{
+				std::memcpy(kept, now, pending[i].bytes);
+			}
+		}
+
+		pending_count = 0;
+		used = 0;
+	};
+
+	u64 count = 0;
+	u64 at = chimera_shadow_data_at;
+	m_rtts.chimera_for_each_surface([&](vk::render_target* surface)
+	{
+		// One whose pixels were moved off the device for want of room is not
+		// followed there; it comes back from a load empty
+		if (!surface->value || count >= chimera_shadow_max_records)
+		{
+			return;
+		}
+
+		chimera_shadow_record record = chimera_describe(surface);
+		record.offset = at;
+
+		if (surface->current_layout == VK_IMAGE_LAYOUT_UNDEFINED)
+		{
+			// Made, and nothing drawn to it or loaded into it yet
+			record.kind = vk::render_target::chimera_untouched;
+		}
+		else
+		{
+			const u64 bytes = surface->chimera_copy_bytes();
+			if (!bytes || bytes > m_chimera_stage_size || at + bytes > shadow_size)
+			{
+				return;
+			}
+
+			if (used + bytes > m_chimera_stage_size || pending_count == pending.size())
+			{
+				run_batch();
+			}
+
+			surface->chimera_copy_out(*m_current_command_buffer, m_chimera_stage, used);
+			pending[pending_count++] = { used, at, bytes };
+			used = (used + bytes + 63) & ~u64{63};
+
+			record.kind = vk::render_target::chimera_pixels;
+			record.bytes = bytes;
+			at = (at + bytes + 63) & ~u64{63};
+		}
+
+		if (std::memcmp(&table[count], &record, sizeof(record)) != 0)
+		{
+			table[count] = record;
+		}
+
+		count++;
+	});
+
+	run_batch();
+
+	const chimera_shadow_header now{ chimera_shadow_magic, count, at, 0 };
+	if (std::memcmp(head, &now, sizeof(now)) != 0)
+	{
+		*head = now;
+	}
+
+	chimera_rsx_shadow_set_current(1);
+}
+
+// After the renderer has been made again: every surface the store kept gets an
+// image of the shape it had, and the pixels it had when the state was taken.
+void VKGSRender::chimera_restore_surfaces()
+{
+	u8* shadow = nullptr;
+	u64 shadow_size = 0;
+	chimera_rsx_shadow_block(&shadow, &shadow_size);
+	const auto head = reinterpret_cast<const chimera_shadow_header*>(shadow);
+	const auto table = reinterpret_cast<const chimera_shadow_record*>(head + 1);
+	const u64 count = std::min<u64>(head->count, chimera_shadow_max_records);
+	const bool stage = chimera_stage_ready();
+
+	u64 used = 0;
+	const auto run_batch = [&]()
+	{
+		if (!used)
+		{
+			return;
+		}
+
+		VkMappedMemoryRange range = { .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE };
+		range.memory = m_chimera_stage_memory;
+		range.size = std::min<u64>((used + 4095) & ~u64{4095}, m_chimera_stage_size);
+		vkFlushMappedMemoryRanges(*m_device, 1, &range);
+		flush_command_queue(true, true);
+		used = 0;
+	};
+
+	u32 kept = 0, untouched = 0, empty = 0;
+	m_rtts.chimera_for_each_surface([&](vk::render_target* surface)
+	{
+		const chimera_shadow_record shape = chimera_describe(surface);
+		const chimera_shadow_record* found = nullptr;
+		for (u64 i = 0; i < count; i++)
+		{
+			if (table[i].surface == shape.surface)
+			{
+				found = &table[i];
+				break;
+			}
+		}
+
+		u32 kind = vk::render_target::chimera_lost;
+		u64 stage_at = 0;
+		if (found && found->width == shape.width && found->height == shape.height &&
+			found->format == shape.format && found->samples == shape.samples)
+		{
+			if (found->kind == vk::render_target::chimera_untouched)
+			{
+				kind = vk::render_target::chimera_untouched;
+			}
+			else if (stage && found->kind == vk::render_target::chimera_pixels &&
+				found->bytes == surface->chimera_copy_bytes() && found->bytes <= m_chimera_stage_size &&
+				found->offset + found->bytes <= shadow_size)
+			{
+				if (used + found->bytes > m_chimera_stage_size)
+				{
+					run_batch();
+				}
+
+				std::memcpy(m_chimera_stage_ptr + used, shadow + found->offset, found->bytes);
+				stage_at = used;
+				used = (used + found->bytes + 63) & ~u64{63};
+				kind = vk::render_target::chimera_pixels;
+			}
+		}
+
+		surface->chimera_reseat_vk(*m_current_command_buffer, m_chimera_stage, stage_at, kind);
+		(kind == vk::render_target::chimera_pixels ? kept : kind == vk::render_target::chimera_untouched ? untouched : empty)++;
+	});
+
+	run_batch();
+	rsx_log.warning("chimera: %u surfaces came back from the load with their pixels, %u that had none yet, %u without", kept, untouched, empty);
+}
+
+// chimera: has the ground moved? Every handle this renderer holds was handed
+// out by one Vulkan device and lives in the machine's memory, so a savestate
+// brings the handles back into a session where that device is gone: the
+// frontend refuses every command that names one. So the device the objects
+// came from is compared with the one the commands land on, at the head of
+// the FIFO's local task, and when it has changed everything is let go and
+// made again - with nothing crossing to the frontend while it is let go,
+// because what is named there is another device's.
+//
+// The flag is the frontend's word that the machine was loaded: a state taken
+// before this renderer first looked carries 0 for the device, which then
+// cannot vouch for what the objects are (the OpenGL renderer's trap, chimera
+// issue 126).
+void VKGSRender::chimera_check_vk_device(bool thread_started)
+{
+	if (m_chimera_vk_rebuilding)
+	{
+		return;
+	}
+
+	const bool after_load = chimera_rpcs3_vulkan_take_state_loaded() != 0;
+	const u64 live = chimera_rpcs3_vulkan_context();
+	if (live == 0 || live == m_chimera_vk_device)
+	{
+		return;
+	}
+
+	if ((m_chimera_vk_device != 0 || after_load) && m_device != VK_NULL_HANDLE)
+	{
+		// to stderr, as the OpenGL bridge's cores say it: this is about the
+		// session, never the machine
+		fprintf(stderr, "chimera: these Vulkan objects came from another device (%llu, now %llu); rebuilding\n",
+			static_cast<unsigned long long>(m_chimera_vk_device), static_cast<unsigned long long>(live));
+
+		// The surfaces are kept when the state that was loaded brought their
+		// pixels with it (chimera_shadow_surfaces); otherwise they go with
+		// everything else.
+		const bool keep_surfaces = chimera_shadow_usable(after_load && thread_started);
+
+		m_chimera_vk_rebuilding = true;
+		chimera_rpcs3_vulkan_quiet();
+		vk::destroy_pipe_compiler();
+		chimera_vk_teardown(keep_surfaces);
+		chimera_rpcs3_vulkan_old_device_gone();
+
