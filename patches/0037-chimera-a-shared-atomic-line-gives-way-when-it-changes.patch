diff --git a/rpcs3/Emu/Memory/vm_reservation.h b/rpcs3/Emu/Memory/vm_reservation.h
--- a/rpcs3/Emu/Memory/vm_reservation.h
+++ b/rpcs3/Emu/Memory/vm_reservation.h
@@ -34,6 +34,53 @@
 	void reservation_update(u32 addr);
 	std::pair<bool, u64> try_reservation_update(u32 addr);
 
+	// Chimera: which CPU last completed a conditional store on each of the 512
+	// slots reservation_acquire hashes every address into. Same slots, so the
+	// same aliasing the emulator's own reservation table already has, and no
+	// new notion of "a line" anywhere.
+	//
+	// A conditional store publishes something another CPU may be about to
+	// read. On hardware the other CPUs are running while it does; on vsched
+	// one thread holds the machine for eighty thousand instructions, which is
+	// long enough for a participant in a lock-free protocol to publish a state
+	// and retract it again with nobody having been able to look (chimera#125:
+	// Unreal Engine 3's garbage collector re-increments its participant count
+	// about ten instructions after decrementing it, so its barrier never
+	// closes). Giving way after EVERY successful atomic fixes that and costs
+	// 6x. Giving way when the slot's previous conditional store came from
+	// another CPU costs, on Mortal Kombat's stuck frames, one give-way in 227.
+	//
+	// It is a statement about sharing, not about waiting: nobody in that
+	// barrier ever waits on the line (eight of 33.4 million stores found a
+	// reservation waiter registered, 149 found another CPU holding a
+	// reservation), because the window in which they would be seen waiting is
+	// the same ten instructions the bug is made of.
+	inline bool reservation_cpu_alternated(u32 addr, u32 cpu_id)
+	{
+		extern u32 g_reservation_last_cpu[65536 / 128];
+
+		u32& last = g_reservation_last_cpu[(addr & 0xff80) / 128];
+
+		if (last == cpu_id)
+		{
+			return false;
+		}
+
+		last = cpu_id;
+		return true;
+	}
+
+	// Hand the machine to the next runnable CPU, charging nothing: the
+	// instructions have been charged already, and on hardware the others were
+	// running anyway. Nothing outside a core, where there is no scheduler to
+	// give way to.
+	inline void reservation_give_way()
+	{
+#ifdef CHIMERA_CORE
+		vsched_yield(0);
+#endif
+	}
+
 	struct alignas(8) reservation_waiter_t
 	{
 		u32 wait_flag = 0;
