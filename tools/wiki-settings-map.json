{
  "_comment": [
    "Every Setting name the RPCS3 wiki's per-game Configuration tables use, and",
    "what it becomes in this core. 'setting' names the declared setting it maps",
    "onto, with 'values' translating the wiki's option text; null means the core",
    "does not expose it, with 'why'. tools/wiki-import.py REFUSES a harvest that",
    "contains a name not listed here, so the wiki cannot grow a recommendation",
    "that this core silently ignores. A value missing from 'values' is reported",
    "per game as unsupported - it is never rounded to the nearest option."
  ],
  "Accurate PPU 128 reservations": {
    "setting": "accuratePpu128Reservations",
    "values": {
      "Always Enabled": -1,
      "Disabled": 0
    }
  },
  "Accurate RSX reservation access": {
    "setting": "accurateRsxReservationAccess",
    "values": {
      "On": true,
      "Off": false
    }
  },
  "Accurate SPU DMA": {
    "setting": "accurateSpuDma",
    "values": {
      "On": true,
      "Off": false
    }
  },
  "Allow Host GPU Labels": {
    "setting": "allowHostGpuLabels",
    "values": {
      "On": true,
      "Off": false
    }
  },
  "Anisotropic filter": {
    "setting": "anisotropicFilter",
    "same": true
  },
  "Anti-aliasing": {
    "setting": "antiAliasing",
    "same": true
  },
  "Asynchronous texture streaming": {
    "setting": null,
    "why": "a Vulkan renderer option; this core draws with OpenGL"
  },
  "Audio buffer duration": {
    "setting": null,
    "why": "host audio output: the core hands every sample to the frontend, and there is no host audio device to buffer or stretch for"
  },
  "Audio format": {
    "setting": null,
    "why": "'Automatic' asks the host's audio device what it can play, and the core's audio has none; the frontend takes stereo"
  },
  "Camera input": {
    "setting": null,
    "why": "no camera device is emulated here"
  },
  "Camera settings": {
    "setting": null,
    "why": "no camera device is emulated here"
  },
