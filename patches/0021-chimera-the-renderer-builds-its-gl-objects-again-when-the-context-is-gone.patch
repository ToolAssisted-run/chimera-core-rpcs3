 }
 
+#ifdef CHIMERA_CORE
+// which context the calls are landing on (miniBox source/gl: GL_OP_CONTEXT_ID).
+// Zero when there is no bridge, or the host predates the question.
+extern "C" uint64_t chimera_gl_context_id(void);
+#else
+static inline uint64_t chimera_gl_context_id(void) { return 0; }
+#endif
+
+// chimera: has the ground moved? The objects this renderer holds are names a
+// particular GL context handed out, and a savestate carries those names into
+// whatever session loads it. Comparing the context they came from with the one
+// the calls are landing on is the only way to notice - the driver refuses the
+// calls and the guest is never told - and the answer is to build them again.
+//
+// Cheap enough for the FIFO loop: one call across the bridge and an integer
+// compare, against a frame's worth of drawing.
+void GLGSRender::chimera_check_gl_context()
+{
+	const u64 live = chimera_gl_context_id();
+	if (live == 0 || live == m_chimera_gl_context)
+	{
+		// 0 is "cannot tell" - no bridge, or a host older than the question -
+		// and a renderer that cannot tell must assume nothing moved
+		return;
+	}
+
+	if (m_chimera_gl_context != 0)
+	{
+		rsx_log.warning("chimera: these GL objects came from another context (%llu, now %llu); rebuilding",
+			m_chimera_gl_context, live);
+		chimera_gl_teardown();
+		chimera_gl_setup();
+
+		// Nothing the renderer thought was set up still is: the program it had
+		// bound, the framebuffer it was drawing into, the textures it had
+		// uploaded were all named by the context that is gone. Saying so is
+		// what makes the next draw fetch them again rather than reach for a
+		// handle the driver no longer knows.
+		m_graphics_state |= rsx::pipeline_state::all_dirty;
+		m_draw_fbo = nullptr;
+		m_program = nullptr;
+	}
+	m_chimera_gl_context = live;
+}
+
 void GLGSRender::do_local_task(rsx::FIFO::state state)
 {
+	chimera_check_gl_context();
+
 	if (!work_queue.empty())
 	{
 		std::lock_guard lock(queue_guard);
diff --git a/rpcs3/Emu/RSX/GL/GLGSRender.h b/rpcs3/Emu/RSX/GL/GLGSRender.h
index 357635c1e..ef46a3baf 100644
--- a/rpcs3/Emu/RSX/GL/GLGSRender.h
+++ b/rpcs3/Emu/RSX/GL/GLGSRender.h
@@ -227,6 +227,22 @@ protected:
 
 	void on_init_thread() override;
 	void on_exit() override;
+
+	// chimera: the GL objects, apart from the machine.
+	//
+	// Every object this renderer holds is a NAME the driver handed out, and
+	// those names live in emulated memory, so a whole-machine savestate takes
+	// them with it - into a session where the context that owned them is gone.
+	// Every call naming one is then refused and nothing says so, because the
+	// bridge answers the guest, not the driver. So the two halves of the
+	// renderer's life are split: what belongs to the CONTEXT can be torn down
+	// and built again without touching what belongs to the MACHINE.
+	void chimera_gl_setup();
+	void chimera_gl_teardown();
+	void chimera_check_gl_context();
+
+	// which context the objects above came from; 0 before there is one
+	u64 m_chimera_gl_context = 0;
 	void flip(const rsx::display_flip_info_t& info) override;
 
 	void do_local_task(rsx::FIFO::state state) override;
