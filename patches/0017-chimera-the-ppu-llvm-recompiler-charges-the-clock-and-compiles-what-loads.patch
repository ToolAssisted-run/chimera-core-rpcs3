+#ifdef CHIMERA_CORE
+void PPUTranslator::ChimeraCharge()
+{
+	if (!m_chimera_pending)
+		return;
+	const u32 n = std::exchange(m_chimera_pending, 0);
+	const auto ptr = m_ir->CreatePtrAdd(m_thread, m_ir->getInt64(::offset32(&ppu_thread::chimera_budget)));
+	const auto left = m_ir->CreateSub(m_ir->CreateLoad(GetType<s64>(), ptr), m_ir->getInt64(n));
+	m_ir->CreateStore(left, ptr);
+	const auto go = BasicBlock::Create(m_context, fmt::format("__budget_ok_0x%x", m_addr), m_function);
+	const auto dry = BasicBlock::Create(m_context, fmt::format("__budget_dry_0x%x", m_addr), m_function);
+	m_ir->CreateCondBr(m_ir->CreateICmpSGT(left, m_ir->getInt64(0)), go, dry, m_md_likely);
+	m_ir->SetInsertPoint(dry);
+	Call(GetType<void>(), "__chimera_budget", m_thread);
+	m_ir->CreateBr(go);
+	m_ir->SetInsertPoint(go);
+}
+#endif
