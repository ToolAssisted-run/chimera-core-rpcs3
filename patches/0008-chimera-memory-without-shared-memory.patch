+#ifdef CHIMERA_CORE
+// Chimera: no page fault registers code on demand. Every table entry of a
+// freshly mapped page points here instead of at nothing; the first
+// execution decodes the page (the interpreter tail-chains through the table
+// without the loop's checks, so the entries must never be empty) and
+// returns to the dispatch loop, which re-dispatches at the same address.
+static void ppu_chimera_unregistered(ppu_thread& ppu, ppu_opcode_t, be_t<u32>* this_op, ppu_intrp_func*)
