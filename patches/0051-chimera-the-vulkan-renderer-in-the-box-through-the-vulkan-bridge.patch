+	void render_target::chimera_copy_out(vk::command_buffer& cmd, VkBuffer buffer, u64 offset)
+	{
+		vk::viewable_image* src = this;
+		if (samples() > 1)
+		{
+			// The planar image cannot be copied out as it is; its pixels go
+			// through the linear one, as they do when a game samples it
+			if (!resolve_surface)
+			{
+				get_resolve_target_safe(cmd);
+				msaa_flags |= rsx::surface_state_flags::require_resolve;
+			}
+
+			if (msaa_flags & rsx::surface_state_flags::require_resolve)
+			{
