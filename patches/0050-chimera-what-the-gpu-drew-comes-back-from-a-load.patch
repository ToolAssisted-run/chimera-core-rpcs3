-		chimera_gl_teardown();
+		// The surfaces are kept when the state that was loaded brought their
+		// pixels with it (chimera_shadow_surfaces); otherwise they go with
+		// everything else, as they always did.
+		const bool keep_surfaces = after_load && s_chimera_shadow_usable && s_chimera_shadow &&
+			reinterpret_cast<const chimera_shadow_header*>(s_chimera_shadow)->magic == chimera_shadow_magic;
+		s_chimera_shadow_usable = false;
+		chimera_gl_teardown(keep_surfaces);
