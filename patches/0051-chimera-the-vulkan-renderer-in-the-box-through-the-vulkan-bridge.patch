+#if defined(CHIMERA_CORE)
+// which Vulkan device the frontend has now, 0 when it cannot say; whether the
+// machine's memory was replaced since this was last asked; and the switch
+// that keeps commands from crossing while a gone device's objects are let go
+// (waterbox/vk-shim.cpp)
+extern "C" u64 chimera_rpcs3_vulkan_context(void);
+extern "C" int chimera_rpcs3_vulkan_take_state_loaded(void);
+extern "C" void chimera_rpcs3_vulkan_quiet(void);
+extern "C" void chimera_rpcs3_vulkan_old_device_gone(void);
+
+// ---- chimera: what the GPU drew is kept with the machine (chimera issue 190) ----
+//
+// A render target lives on the device, a savestate is the machine's memory and
+// nothing of the device's, and after a load the device is another one. What
+// had been drawn and is not drawn again within a frame or two would stay lost:
+// a game that fills a target once and uses it for minutes draws black from it
+// for as long as anybody looks.
+//
+// So, as the OpenGL renderer does (GLGSRender.cpp, where the reasons are): the
+// pixels are copied out when the engine says a state is about to be taken,
+// into a block of this core's own memory that the state carries, and after a
+// load the surface store is KEPT - each surface lets go of its dead image, is
+// given a new one of the same shape, and gets its pixels back. The copy does
+// not go into the console's memory, which a game can read.
+//
+// Two things are this renderer's own. OpenGL has drawn what it was told to
+// draw; here it is still in a command buffer, so that is handed in and waited
+// for first - with the buffer kept, the way this renderer does it when a
+// fault catches it half way through one. And a multisampled target has its
+// pixels in a linear twin, which is what is copied: this renderer makes and
+// fills that twin itself whenever a game samples the target.
+// The block, and what it says about itself (GLGSRender.cpp keeps both)
+extern "C" void chimera_rsx_shadow_block(u8** shadow, u64* shadow_size);
+extern "C" void chimera_rsx_shadow_set_current(int current);
+extern "C" int chimera_rsx_shadow_take_usable(void);
+
+namespace
+{
+	struct chimera_shadow_header
+	{
+		u64 magic;
+		u64 count;
+		u64 end;
+		u64 unused;
+	};
+
+	struct chimera_shadow_record
+	{
+		u64 surface;   // the vk::render_target it is of
+		u64 offset;    // of its pixels, from the start of the block
+		u64 bytes;
+		u32 width;
+		u32 height;
+		u32 format;
+		u32 samples;
+		u32 kind;      // vk::render_target::chimera_pixels or chimera_untouched
+		u32 unused;
+	};
+
+	constexpr u64 chimera_shadow_magic = 0x4B56485352495843ull;   // "CXIRSHVK"
+	constexpr u64 chimera_shadow_max_records = 2048;
+	constexpr u64 chimera_shadow_data_at = (sizeof(chimera_shadow_header) + chimera_shadow_max_records * sizeof(chimera_shadow_record) + 4095) & ~u64{4095};
+	constexpr u64 chimera_stage_bytes = 64ull << 20;
+
+	// Was the state that has just been loaded taken with the copies made?
+	bool chimera_shadow_usable(bool wanted)
+	{
+		const bool usable = chimera_rsx_shadow_take_usable() != 0;
+		u8* shadow = nullptr;
+		u64 shadow_size = 0;
+		chimera_rsx_shadow_block(&shadow, &shadow_size);
+		return wanted && usable && shadow && shadow_size > chimera_shadow_data_at &&
+			reinterpret_cast<const chimera_shadow_header*>(shadow)->magic == chimera_shadow_magic;
+	}
+
+	chimera_shadow_record chimera_describe(vk::render_target* surface)
+	{
+		chimera_shadow_record record{};
+		record.surface = reinterpret_cast<u64>(surface);
+		record.width = surface->width();
+		record.height = surface->height();
+		record.format = static_cast<u32>(surface->format());
+		record.samples = surface->samples();
+		return record;
+	}
+}
+
+extern "C" void chimera_vk_shadow_save(void)
+{
+	if (auto render = dynamic_cast<VKGSRender*>(rsx::get_current_renderer()))
+	{
+		render->chimera_shadow_surfaces();
+	}
+}
