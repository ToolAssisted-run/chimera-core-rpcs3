+	case SPU_RdSigNotify1:    return ch_cnt(SPU_OFF_64(ch_snr1), false, true);
+	case SPU_RdSigNotify2:    return ch_cnt(SPU_OFF_64(ch_snr2), false, true);
 	case MFC_RdAtomicStat:    return ch_cnt(SPU_OFF_64(ch_atomic_stat));
 
