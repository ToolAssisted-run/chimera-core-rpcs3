 	case MFC_RdTagStat:       return ch_cnt(SPU_OFF_64(ch_tag_stat));
 	case MFC_RdListStallStat: return ch_cnt(SPU_OFF_64(ch_stall_stat));
-	case SPU_RdSigNotify1:    return ch_cnt(SPU_OFF_64(ch_snr1));
