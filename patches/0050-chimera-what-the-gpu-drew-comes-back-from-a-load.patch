+// ---- chimera: what the GPU drew is kept with the machine (chimera issue 190) ----
+//
+// A render target lives in the driver. The console's memory under it is never
+// written unless Write Color Buffers is on, a savestate is the machine's memory
+// and nothing of the driver's, and the rebuild below used to throw the whole
+// surface store away - so after a load everything that had been drawn and not
+// drawn again was gone. Most of a frame is drawn again within a frame or two.
+// What is not stays lost: Dead or Alive 5 draws its fighters with targets it
+// filled once, long before, and after a load it drew them black for as long as
+// anybody looked.
+//
+// So the pixels are copied out when the engine says a state is about to be
+// taken (the StateSaving export), into a block of this core's own memory that
+// the state carries, and after a load the surface store is KEPT: each surface
+// lets go of its dead image, is given a new one of the same shape, and gets its
+// pixels back. Everything the store knew - which surface inherits from which,
+// what is bound, what is still to be cleared - is the machine's and was always
+// in the state.
+//
+// The copy does NOT go into the console's memory, although the machinery for
+// that exists (Write Color Buffers): a game can read that memory, and one that
+// did would see different bytes depending on whether a state happened to be
+// taken, which is the frontend's business and none of the machine's.
+//
+// Three things keep it from costing a state more than it must. A surface is
+// read into memory no state carries and compared with the copy already held,
+// so one that has not changed dirties no page and adds nothing to a delta. The
+// copies sit in the order the store walks its surfaces, so nothing is
+// allocated. And nothing here runs on the RSX thread: it is stopped between
+// frames, the store is whole wherever it stopped, and reading an image changes
+// nothing the renderer believes about the driver's state.
+namespace
+{
+	struct chimera_shadow_header
+	{
+		u64 magic;
+		u64 count;
+		u64 end;
+		u64 unused;
+	};
+
+	struct chimera_shadow_record
+	{
+		u64 surface;   // the gl::render_target it is of
+		u64 offset;    // of its pixels, from the start of the block
+		u64 bytes;
+		u32 width;
+		u32 height;
+		u32 internal_format;
+		u32 format;    // how the pixels were asked for, and are given back
+		u32 type;
+		u32 pixel_size;
+	};
+
+	constexpr u64 chimera_shadow_magic = 0x5744485352495843ull;   // "CXIRSHDW"
+	constexpr u64 chimera_shadow_max_records = 2048;
+	constexpr u64 chimera_shadow_data_at = (sizeof(chimera_shadow_header) + chimera_shadow_max_records * sizeof(chimera_shadow_record) + 4095) & ~u64{4095};
+
+	u8* s_chimera_shadow = nullptr;          // in every state
+	u64 s_chimera_shadow_size = 0;
+	u8* s_chimera_scratch = nullptr;         // in none
+	u64 s_chimera_scratch_size = 0;
+	// The block describes the surfaces as they are NOW: set by a copy, cleared
+	// when the next frame starts. A state taken without the copy - an engine
+	// that does not ask, or one told not to - carries it cleared.
+	bool s_chimera_shadow_current = false;
+	// ...and as they were in the state that has just been loaded.
+	bool s_chimera_shadow_usable = false;
+
+	// A way to ask for a target's pixels that gives every bit back.
+	bool chimera_lossless_transfer(GLenum internal_format, GLenum& format, GLenum& type, u32& pixel_size)
+	{
+		switch (internal_format)
+		{
+		case GL_BGRA: case GL_BGRA8_EXT: case GL_RGBA8:
+			format = GL_BGRA; type = GL_UNSIGNED_BYTE; pixel_size = 4; return true;
+		case GL_RGB565:
+			format = GL_RGB; type = GL_UNSIGNED_SHORT_5_6_5; pixel_size = 2; return true;
+		case GL_RGB5_A1:
+			format = GL_BGRA; type = GL_UNSIGNED_SHORT_1_5_5_5_REV; pixel_size = 2; return true;
+		case GL_R8:
+			format = GL_RED; type = GL_UNSIGNED_BYTE; pixel_size = 1; return true;
+		case GL_RG8:
+			format = GL_RG; type = GL_UNSIGNED_BYTE; pixel_size = 2; return true;
+		case GL_R16:
+			format = GL_RED; type = GL_UNSIGNED_SHORT; pixel_size = 2; return true;
+		case GL_RG16:
+			format = GL_RG; type = GL_UNSIGNED_SHORT; pixel_size = 4; return true;
+		case GL_R16F:
+			format = GL_RED; type = GL_HALF_FLOAT; pixel_size = 2; return true;
+		case GL_RG16F:
+			format = GL_RG; type = GL_HALF_FLOAT; pixel_size = 4; return true;
+		case GL_RGBA16F:
+			format = GL_RGBA; type = GL_HALF_FLOAT; pixel_size = 8; return true;
+		case GL_R32F:
+			format = GL_RED; type = GL_FLOAT; pixel_size = 4; return true;
+		case GL_RG32F:
+			format = GL_RG; type = GL_FLOAT; pixel_size = 8; return true;
+		case GL_RGBA32F:
+			format = GL_RGBA; type = GL_FLOAT; pixel_size = 16; return true;
+		case GL_DEPTH_COMPONENT16:
+			format = GL_DEPTH_COMPONENT; type = GL_UNSIGNED_SHORT; pixel_size = 2; return true;
+		case GL_DEPTH_COMPONENT32F:
+			format = GL_DEPTH_COMPONENT; type = GL_FLOAT; pixel_size = 4; return true;
+		case GL_DEPTH24_STENCIL8:
+			format = GL_DEPTH_STENCIL; type = GL_UNSIGNED_INT_24_8; pixel_size = 4; return true;
+		case GL_DEPTH32F_STENCIL8:
+			format = GL_DEPTH_STENCIL; type = GL_FLOAT_32_UNSIGNED_INT_24_8_REV; pixel_size = 8; return true;
+		default:
+			return false;
+		}
+	}
+}
+
+// The driver gives the two blocks once, at Init, so that both are where they
+// are in every state: the first is ordinary memory, the second is memory no
+// state carries.
+extern "C" void chimera_rsx_shadow_setup(void* shadow, u64 shadow_size, void* scratch, u64 scratch_size)
+{
+	s_chimera_shadow = static_cast<u8*>(shadow);
+	s_chimera_shadow_size = shadow_size;
+	s_chimera_scratch = static_cast<u8*>(scratch);
+	s_chimera_scratch_size = scratch_size;
+}
+
+extern "C" void chimera_rsx_shadow_frame_begins(void)
+{
+	s_chimera_shadow_current = false;
+}
+
+extern "C" void chimera_rsx_shadow_state_loaded(void)
+{
+	s_chimera_shadow_usable = s_chimera_shadow_current;
+}
+
+extern "C" void chimera_rsx_shadow_save(void)
+{
+	if (auto render = dynamic_cast<GLGSRender*>(rsx::get_current_renderer()))
+	{
+		render->chimera_shadow_surfaces();
+	}
+}
+
+void GLGSRender::chimera_shadow_surfaces()
+{
+	// A state taken straight after a load, before a frame has run: the
+	// surfaces still name the images of the context that is gone (the rebuild
+	// happens when the RSX thread next runs), so there is nothing to read -
+	// and nothing to do, because the block came with the state that was loaded
+	// and describes exactly this machine. It is left as it is, with what it
+	// says about itself.
+	if (const u64 live = chimera_gl_context_id(); live != 0 && live != m_chimera_gl_context)
+	{
+		return;
+	}
+
+	s_chimera_shadow_current = false;
+	if (!s_chimera_shadow || !s_chimera_scratch || s_chimera_shadow_size <= chimera_shadow_data_at ||
+		!gl::get_driver_caps().ARB_direct_state_access_supported)
+	{
+		return;
+	}
+
+	auto head = reinterpret_cast<chimera_shadow_header*>(s_chimera_shadow);
+	auto table = reinterpret_cast<chimera_shadow_record*>(head + 1);
+
+	// Raw calls, and nothing left changed that the renderer keeps track of:
+	// the RSX thread is wherever the frame's end found it, and may be between
+	// binding a buffer and using it. It sets the pack parameters itself before
+	// every transfer (pixel_pack_settings::apply), so those need no restoring.
+	GLint pack_buffer = 0;
+	glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+	if (pack_buffer) glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	glPixelStorei(GL_PACK_SWAP_BYTES, GL_FALSE);
+	glPixelStorei(GL_PACK_LSB_FIRST, GL_FALSE);
+	glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+	glPixelStorei(GL_PACK_IMAGE_HEIGHT, 0);
+	glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+	glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+	glPixelStorei(GL_PACK_SKIP_IMAGES, 0);
+
+	u64 count = 0;
+	u64 at = chimera_shadow_data_at;
+	m_rtts.chimera_for_each_surface([&](gl::render_target* surface)
+	{
+		GLenum format = 0, type = 0;
+		u32 pixel_size = 0;
+		// A multisampled image cannot be read back as it is; its surface comes
+		// back from a load without its pixels, as every surface used to.
+		if (!surface->id() || surface->samples() > 1 ||
+			!chimera_lossless_transfer(static_cast<GLenum>(surface->get_internal_format()), format, type, pixel_size))
+		{
+			return;
+		}
+
+		const u32 width = surface->width(), height = surface->height();
+		const u64 row = u64{width} * pixel_size;
+		const u64 bytes = row * height;
+		if (!bytes || row > s_chimera_scratch_size || count >= chimera_shadow_max_records || at + bytes > s_chimera_shadow_size)
+		{
+			return;
+		}
+
+		// In pieces the scratch block holds, and only what differs is written:
+		// a page that is not written is not in the next delta.
+		const u32 step = static_cast<u32>(std::min<u64>(height, s_chimera_scratch_size / row));
+		for (u32 y = 0; y < height; y += step)
+		{
+			const u32 rows = std::min(step, height - y);
+			const u64 piece = row * rows;
+			glGetTextureSubImage(surface->id(), 0, 0, y, 0, width, rows, 1, format, type, static_cast<GLsizei>(piece), s_chimera_scratch);
+			u8* const kept = s_chimera_shadow + at + row * y;
+			if (std::memcmp(kept, s_chimera_scratch, piece) != 0)
+			{
+				std::memcpy(kept, s_chimera_scratch, piece);
+			}
+		}
+
+		chimera_shadow_record record{};
+		record.surface = reinterpret_cast<u64>(surface);
+		record.offset = at;
+		record.bytes = bytes;
+		record.width = width;
+		record.height = height;
+		record.internal_format = static_cast<u32>(surface->get_internal_format());
+		record.format = format;
+		record.type = type;
+		record.pixel_size = pixel_size;
+		if (std::memcmp(&table[count], &record, sizeof(record)) != 0)
+		{
+			table[count] = record;
+		}
+
+		count++;
+		at = (at + bytes + 63) & ~u64{63};
+	});
+
+	const chimera_shadow_header now{ chimera_shadow_magic, count, at, 0 };
+	if (std::memcmp(head, &now, sizeof(now)) != 0)
+	{
+		*head = now;
+	}
+
+	if (pack_buffer) glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer);
+	s_chimera_shadow_current = true;
+}
+
+// After the context has been set up again: every surface the store kept gets
+// an image of the shape it had, and the pixels it had when the state was taken.
+// One the copy has nothing for - a multisampled one, or a format it does not
+// know - is marked as holding nothing, which is what it now holds.
+void GLGSRender::chimera_restore_surfaces()
+{
+	const auto head = reinterpret_cast<const chimera_shadow_header*>(s_chimera_shadow);
+	const auto table = reinterpret_cast<const chimera_shadow_record*>(head + 1);
+	const u64 count = std::min<u64>(head->count, chimera_shadow_max_records);
+
+	glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	glPixelStorei(GL_UNPACK_SWAP_BYTES, GL_FALSE);
+	glPixelStorei(GL_UNPACK_LSB_FIRST, GL_FALSE);
+	glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+	glPixelStorei(GL_UNPACK_IMAGE_HEIGHT, 0);
+	glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+	glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+	glPixelStorei(GL_UNPACK_SKIP_IMAGES, 0);
+
+	u32 kept = 0, empty = 0;
+	m_rtts.chimera_for_each_surface([&](gl::render_target* surface)
+	{
+		surface->chimera_reseat();
+
+		const chimera_shadow_record* found = nullptr;
+		for (u64 i = 0; i < count; i++)
+		{
+			if (table[i].surface == reinterpret_cast<u64>(surface))
+			{
+				found = &table[i];
+				break;
+			}
+		}
+
+		if (found && surface->samples() == 1 &&
+			found->width == surface->width() && found->height == surface->height() &&
+			found->internal_format == static_cast<u32>(surface->get_internal_format()) &&
+			found->offset + found->bytes <= s_chimera_shadow_size)
+		{
+			glTextureSubImage2D(surface->id(), 0, 0, 0, found->width, found->height, found->format, found->type, s_chimera_shadow + found->offset);
+			kept++;
+			return;
+		}
+
+		surface->clear_rw_barrier();
+		surface->state_flags |= rsx::surface_state_flags::erase_bkgnd;
+		empty++;
+	});
+
+	rsx_log.warning("chimera: %u surfaces came back from the load with their pixels, %u without", kept, empty);
+}
