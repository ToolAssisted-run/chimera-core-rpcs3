  "settings": [
    {
      "name": "renderer",
      "display": "setting.renderer",
      "type": "enum",
      "options": [
        "opengl-hw",
        "vulkan-hw"
      ],
      "default": "vulkan-hw",
      "description": "setting.renderer.about"
    },
    {
      "name": "writeColorBuffers",
      "display": "setting.writecolorbuffers",
      "type": "bool",
      "default": false,
      "description": "setting.writecolorbuffers.about"
    },
    {
      "name": "readColorBuffers",
      "display": "setting.readcolorbuffers",
      "type": "bool",
      "default": false,
      "description": "setting.readcolorbuffers.about"
    },
    {
      "name": "zcullAccuracy",
      "display": "setting.zcullaccuracy",
      "type": "enum",
      "options": [
        "Precise",
        "Approximate",
        "Relaxed"
      ],
      "default": "Precise",
      "description": "setting.zcullaccuracy.about"
    },
    {
      "name": "resolutionScaleThreshold",
      "display": "setting.resolutionscalethreshold",
      "type": "int",
      "min": 1,
      "max": 1024,
      "default": 16,
      "description": "setting.resolutionscalethreshold.about"
    },
    {
      "name": "frameLimit",
      "display": "setting.framelimit",
      "type": "enum",
      "options": [
        "Off",
        "30",
        "50",
        "60",
        "120",
        "Display",
        "Auto",
        "PS3 Native",
        "Infinite"
      ],
      "default": "PS3 Native",
      "description": "setting.framelimit.about"
    },
    {
      "name": "sleepTimersAccuracy",
      "display": "setting.sleeptimersaccuracy",
      "type": "enum",
      "options": [
        "As Host",
        "Usleep Only",
        "All Timers"
      ],
      "default": "As Host",
      "description": "setting.sleeptimersaccuracy.about"
    },
    {
      "name": "vblankRate",
      "display": "setting.vblankrate",
      "type": "int",
      "min": 1,
      "max": 6000,
      "default": 60,
      "description": "setting.vblankrate.about"
    },
    {
      "name": "vblankNtscFixup",
