  "settings": [
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "opengl-hw"
      ],
      "default": "opengl-hw",
      "description": "RPCS3 has one renderer: its own OpenGL, driving a REAL GPU through the bridge. The GPU is outside the sandbox and different on every machine, render targets a game reads back land in its memory, and a movie recorded this way replays only on the same driver. On a machine that offers no GL context the core draws nothing and says so."
    },
    {
      "name": "spu_decoder",
      "display": "SPU Decoder",
      "type": "enum",
      "options": [
        "asmjit",
        "interpreter"
      ],
      "default": "asmjit",
      "description": "How the SPUs' code runs. 'asmjit' is RPCS3's ASMJIT recompiler: the same results, several times faster, and it charges the machine's clock per loop iteration and function entry. 'interpreter' charges per instruction. Both are deterministic, but they keep slightly different time, so a movie replays only with the decoder it was recorded with."
    },
    {
      "name": "ppu_decoder",
      "display": "PPU Decoder",
      "type": "enum",
      "options": [
        "interpreter",
        "llvm"
      ],
      "default": "interpreter",
      "description": "How the PPU's code runs. 'interpreter' charges the machine's clock per instruction. 'llvm' is RPCS3's LLVM recompiler: every module compiles inside the sandbox when it loads, every session (about ten seconds for the firmware's liblv2, minutes for a big game with its libraries), then runs many times faster; compiled code charges the clock per basic block. Both are deterministic, but they keep slightly different time, so a movie replays only with the decoder it was recorded with. The interpreter is the default until compiled modules can persist between sessions."
    }
  ],
  "firmware": [
    {
      "id": "PS3UPDAT.PUP",
      "display": "PlayStation 3 System Software",
      "description": "Sony's own PS3 system software update, PS3UPDAT.PUP, the file Sony distributes for the console (version 4.80 or newer). The machine decrypts it into its flash at boot, before the first frame, the way a console holds its firmware: the LLE system libraries games link against come from it. Homebrew that only uses lv2 syscalls boots without it; anything real needs it. Two projects on different versions are different machines and do not share movies.",
      "name": "PS3UPDAT.PUP",
      "required": false
    }
  ],
  "engineAssetsNote": "none: the firmware is the user's and the emulator ships no data files of its own for a PS3",
  "precompile": true,
  "_precompile_note": "This core can fill its compile cache without running (SetPrecompile): the frontend runs several precompile sessions side by side before a project first boots, with a progress bar, so the LLVM recompiler starts warm."
}
