+++ b/rpcs3/Emu/Cell/SPUASMJITRecompiler.cpp
@@ -1007,6 +1007,17 @@
 	vsched_budget_expired(VSCHED_SPU);
 }
 
+// Chimera: the count of a channel only another thread fills (a mailbox, a
+// signal, the events, room in the outbound mailbox) was read as empty, so the
+// SPU is polling it; it gives way at once rather than spin out its slice
+// (vsched_poll_yield, chimera#294), and starts a fresh slice when it did
+static void chimera_spu_poll(spu_thread* _spu)
+{
+	const s64 used = vsched_budget_slice() - _spu->chimera_budget;
+	if (vsched_poll_yield(VSCHED_SPU, used))
+		_spu->chimera_budget = vsched_budget_slice();
+}
+
 // Emit: charge the budget by n instructions and, when it runs dry, call the
 // scheduler. Only at points where the SPU state is in memory and the
 // callee-saved registers (cpu, pc0) are all the emitted code relies on.
@@ -1571,14 +1582,38 @@
 
 static u32 spu_rchcnt(spu_thread* _spu, u32 ch)
 {
+#ifdef CHIMERA_CORE
+	const u32 count = _spu->get_ch_count(ch);
+	if (!count && ch == SPU_RdEventStat)
+		chimera_spu_poll(_spu);
+	return count;
+#else
 	return _spu->get_ch_count(ch);
+#endif
 }
 
