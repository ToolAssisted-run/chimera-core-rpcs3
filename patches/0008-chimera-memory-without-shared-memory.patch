+	const u32 addr = vm::get_addr(this_op);
+	if (getenv("CHIMERA_TRACE"))
+		fprintf(stderr, "[chimera] unregistered ppu code at 0x%x (this_op=%p base=%p)\n", addr, static_cast<const void*>(this_op), static_cast<const void*>(vm::g_base_addr));
+	ppu.cia = addr;
+	ppu_register_function_at(addr & -4096, 4096);
+}
+
+extern void ppu_fill_exec_table(u32 addr, u32 size)
+{
+	if (g_cfg.core.ppu_decoder == ppu_decoder_type::llvm)
+	{
