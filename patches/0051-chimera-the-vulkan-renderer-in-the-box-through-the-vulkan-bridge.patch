+		}
+
+		src->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		vkCmdCopyImageToBuffer(cmd, src->value, src->current_layout, buffer, ::size32(regions), regions.data());
