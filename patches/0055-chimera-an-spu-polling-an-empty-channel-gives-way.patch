diff --git a/rpcs3/Emu/Cell/SPUInterpreter.cpp b/rpcs3/Emu/Cell/SPUInterpreter.cpp
--- a/rpcs3/Emu/Cell/SPUInterpreter.cpp
+++ b/rpcs3/Emu/Cell/SPUInterpreter.cpp
@@ -1,3 +1,6 @@
+#ifdef CHIMERA_CORE
+#include "vsched.h"
+#endif
 #include "stdafx.h"
 #include "SPUInterpreter.h"
 
@@ -235,7 +238,31 @@
 template <spu_exec_bit... Flags>
 bool RCHCNT(spu_thread& spu, spu_opcode_t op)
 {
+#ifdef CHIMERA_CORE
+	const u32 count = spu.get_ch_count(op.ra);
+	spu.gpr[op.rt] = v128::from32r(count);
+	// Chimera: an empty count of a channel only another thread fills is a
+	// poll; give way at once rather than spin out the slice (chimera#294).
+	// The interpreter's slice is the scheduler's own budget.
+	if (!count)
+	{
+		switch (op.ra)
+		{
+		case SPU_RdInMbox:
+		case SPU_RdSigNotify1:
+		case SPU_RdSigNotify2:
+		case SPU_RdEventStat:
+		case SPU_WrOutMbox:
+		case SPU_WrOutIntrMbox:
+			vsched_poll_yield(VSCHED_SPU, vsched_budget_slice() - vsched_budget);
+			break;
+		default:
+			break;
+		}
+	}
+#else
 	spu.gpr[op.rt] = v128::from32r(spu.get_ch_count(op.ra));
+#endif
 	return true;
 }
 
