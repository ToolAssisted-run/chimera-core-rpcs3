  "settings": [
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "opengl-hw"
      ],
      "default": "opengl-hw",
      "description": "RPCS3 has one renderer: its own OpenGL, driving a REAL GPU through the bridge. The GPU is outside the sandbox and different on every machine, render targets a game reads back land in its memory, and a movie recorded this way replays only on the same driver. On a machine that offers no GL context the core draws nothing and says so."
    },
    {
      "name": "writeColorBuffers",
      "display": "Write color buffers to memory",
      "type": "bool",
      "default": false,
      "description": "The RSX draws into render targets that also live in the console's memory; on a real PS3 the game can read them back at any time. This makes the renderer write every finished color buffer back into that memory, as the console does. Off by default, as upstream RPCS3 has it: most games never read their own picture, and the readback per render target per frame is expensive - with it on, Resident Evil 5 on the GL renderer ran a 16 GiB sandbox out of memory inside thirty frames, where off it runs. Turn it on for a game that reads the screen back, and the symptom is a picture the game drew from itself coming out black or stale: Oblivion draws its save's thumbnail that way, and without this the icon in the export and in the game's own load menu is black. It is part of the machine, not a display option - a game that reads those pixels can act on them - so a movie made with it on wants it on."
    },
    {
      "name": "readColorBuffers",
      "display": "Read color buffers from memory",
      "type": "bool",
      "default": false,
      "description": "The other direction of the same window: the RSX loads a render target's existing contents out of console memory before drawing over them, as the console does. A game that composites onto a buffer it filled earlier by other means needs it, and without it that earlier content is missing. Off by default, as upstream RPCS3 has it, and for the same reason as its write counterpart - most games never do this and the readback is not free. It is part of the machine, not a display option: the pixels it brings in are pixels the game drew and can draw from, so a movie made with it on wants it on."
    },
    {
      "name": "zcullAccuracy",
      "display": "ZCULL accuracy",
      "type": "enum",
      "options": [
        "Precise",
        "Approximate",
        "Relaxed"
      ],
      "default": "Precise",
      "description": "How exactly the RSX's occlusion counts (ZCULL statistics) are reported back to the game. 'Precise' counts every sample and waits for the GPU; 'Approximate' and 'Relaxed' answer sooner with a less exact count, which some games need to run at all and some misdraw with. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "resolutionScaleThreshold",
      "display": "Resolution scale threshold",
      "type": "int",
      "min": 1,
      "max": 1024,
      "default": 16,
      "description": "Render targets smaller than this many pixels on each side are never scaled by 'Resolution scale'. The wiki writes it as '320x320'; here it is the one number. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing."
    },
    {
      "name": "frameLimit",
      "display": "Framelimit",
      "type": "enum",
      "options": [
        "Off",
        "30",
        "50",
        "60",
        "120",
        "Display",
        "Auto",
        "PS3 Native",
        "Infinite"
      ],
      "default": "PS3 Native",
      "description": "How rpcs3 paces flips. 'PS3 Native' holds a vsync flip until the console's next vblank, as the hardware does; the others make the RSX thread sleep toward a rate, and in this core that sleep is the machine's own time, which starved Mortal Kombat's command stream (chimera#125). This core pins it for determinism, and the default is that pin: the frontend drives the frames, so a change here is an experiment, and one a movie must keep."
    },
    {
      "name": "sleepTimersAccuracy",
      "display": "Sleep timers accuracy",
      "type": "enum",
      "options": [
        "As Host",
        "Usleep Only",
        "All Timers"
      ],
      "default": "As Host",
      "description": "How precisely the console's sleep and timer calls are honoured. The finer settings wake threads exactly on time at a cost in speed. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "vblankRate",
      "display": "Vblank rate",
      "type": "int",
      "min": 1,
      "max": 6000,
      "default": 60,
      "description": "How many vblank events a second the console sees. Games that pace themselves by vblank run faster at a higher rate, and some run correctly only at 120. This core pins it for determinism, and the default is that pin: the frontend drives the frames, so a change here is an experiment, and one a movie must keep."
    },
    {
      "name": "vblankNtscFixup",
      "display": "VBlank NTSC Fixup",
      "type": "bool",
      "default": false,
      "description": "Makes the vblank rate 59.94 instead of 60, as an NTSC console has it. This core pins it for determinism, and the default is that pin: the frontend drives the frames, so a change here is an experiment, and one a movie must keep."
    },
    {
      "name": "multithreadedRsx",
      "display": "Multithreaded RSX",
      "type": "bool",
      "default": false,
      "description": "Offloads part of the RSX's work to another thread. That thread is scheduled like every other in the machine, and the order in which the two finish can differ. This core pins it for determinism, and the default is that pin: the frontend drives the frames, so a change here is an experiment, and one a movie must keep."
    },
    {
      "name": "disableVertexCache",
      "display": "Disable vertex cache",
      "type": "bool",
      "default": false,
      "description": "Stops rpcs3 from reusing vertex data it already uploaded, for games that change it in place. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "strictRenderingMode",
      "display": "Strict rendering mode",
      "type": "bool",
      "default": false,
      "description": "Follows the RSX's rules to the letter where rpcs3 normally takes faster shortcuts: slower, and correct for games the shortcuts break. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "firmwareLibraries",
      "display": "Firmware libraries",
      "type": "string",
      "default": "",
      "description": "System libraries to run from the firmware (LLE) instead of rpcs3's own implementation (HLE), separated by commas, e.g. 'libvdec.sprx'. The wiki names one when rpcs3's version of it is not good enough for a game - libvdec.sprx is the video decoder. Needs the system software; without it there is nothing to run them from and this is ignored. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "accurateRsxReservationAccess",
      "display": "Accurate RSX reservation access",
      "type": "bool",
      "default": false,
      "description": "Makes the RSX honour the Cell's memory reservations exactly when it reads and writes shared memory. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "spuBlockSize",
      "display": "SPU block size",
      "type": "enum",
      "options": [
        "Safe",
        "Mega",
        "Giga"
      ],
      "default": "Safe",
      "description": "How much SPU code the recompiler compiles as one unit. Larger blocks are faster and change where the recompiler charges the clock (per function and loop), so the machine keeps different time. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "spuXfloatAccuracy",
      "display": "SPU xfloat accuracy",
      "type": "enum",
      "options": [
        "Accurate",
        "Approximate",
        "Relaxed",
        "Inaccurate"
      ],
      "default": "Approximate",
      "description": "How exactly the SPUs' non-IEEE floating point is reproduced. Games whose physics or animation go wrong want 'Accurate'. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "handleRsxMemoryTiling",
      "display": "Handle RSX memory tiling",
      "type": "bool",
      "default": false,
      "description": "Emulates the RSX's tiled memory layout when the Cell reads or writes a tiled region, for games that draw from or into one directly. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "forceCpuBlit",
      "display": "Force CPU blit emulation",
      "type": "bool",
      "default": false,
      "description": "Performs the RSX's image copies on the CPU into the console's memory instead of on the GPU, for games that read the result back. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "antiAliasing",
      "display": "Anti-aliasing",
      "type": "enum",
      "options": [
        "Disabled",
        "Auto"
      ],
      "default": "Auto",
      "description": "Whether render targets the game asks to be multisampled are. 'Disabled' draws them without, which some games need to show anything at all. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing."
    },
    {
      "name": "writeDepthBuffer",
      "display": "Write depth buffer",
      "type": "bool",
      "default": false,
      "description": "Writes finished depth buffers back into the console's memory, where a game that reads them expects them. The depth counterpart of 'Write color buffers to memory'. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "readDepthBuffer",
      "display": "Read depth buffer",
      "type": "bool",
      "default": false,
      "description": "Loads a depth buffer's existing contents out of the console's memory before drawing into it. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "resolutionScale",
      "display": "Resolution scale",
      "type": "int",
      "min": 25,
      "max": 800,
      "default": 100,
      "description": "Draws at this percentage of the game's own resolution. The picture the frontend receives changes size with it. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing."
    },
    {
      "name": "driverWakeUpDelay",
      "display": "Driver wake-up delay",
      "type": "int",
      "min": 0,
      "max": 16667,
      "default": 0,
      "description": "Microseconds the RSX thread waits before it wakes to process new commands, for games that race their own command stream. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "shaderQuality",
      "display": "Shader quality",
      "type": "enum",
      "options": [
        "Auto",
        "Low",
        "High",
        "Ultra"
      ],
      "default": "High",
      "description": "The floating point precision the host's shaders use. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing."
    },
    {
      "name": "allowHostGpuLabels",
      "display": "Allow Host GPU Labels",
      "type": "bool",
      "default": false,
      "description": "Lets the host GPU signal the RSX's semaphores directly instead of through rpcs3's own synchronisation. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "disableZcullQueries",
      "display": "Disable ZCull occlusion queries",
      "type": "bool",
      "default": false,
      "description": "Answers every occlusion query as visible without asking the GPU. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "emulateSpecialDepthComparison",
      "display": "Emulate Special Depth Comparison",
      "type": "bool",
      "default": false,
      "description": "Reproduces the RSX's depth comparison where it differs from the host GPU's, for shadows and decals that flicker or vanish. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing."
    },
    {
      "name": "shaderMode",
      "display": "Shader mode",
      "type": "enum",
      "options": [
        "Legacy Recompiler (single-threaded)",
        "Async Recompiler (multi-threaded)",
        "Async Recompiler with Shader Interpreter",
        "Shader Interpreter only"
      ],
      "default": "Legacy Recompiler (single-threaded)",
      "description": "How the host's shaders are made. This core compiles each one on the RSX thread before it draws with it; the asynchronous modes draw without a shader until one is ready, so what is drawn depends on how fast the host compiles. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing. This core pins it for determinism, and the default is that pin: the frontend drives the frames, so a change here is an experiment, and one a movie must keep."
    },
    {
      "name": "preferredSpuThreads",
      "display": "Preferred SPU threads",
      "type": "int",
      "min": 0,
      "max": 6,
      "default": 0,
      "description": "How many SPU threads may run heavy work at the same time; 0 leaves it to rpcs3. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "accurateSpuDma",
      "display": "Accurate SPU DMA",
      "type": "bool",
      "default": false,
      "description": "Makes every SPU DMA transfer exactly as atomic as the hardware's. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "defaultResolution",
      "display": "Default resolution",
      "type": "enum",
      "options": [
        "1920x1080",
        "1920x1080i",
        "1280x720",
        "720x480",
        "720x480i",
        "720x576",
        "720x576i",
        "1600x1080",
        "1440x1080",
        "1280x1080",
        "960x1080"
      ],
      "default": "1280x720",
      "description": "The video mode the console reports to the game as its display's. A game picks its own rendering resolution from it, so it changes what the game does, not only what is shown. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "maxSpursThreads",
      "display": "Maximum SPURS threads",
      "type": "int",
      "min": 1,
      "max": 6,
      "default": 6,
      "description": "The most SPU threads a SPURS task group may run at once. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "rsxFifoAccuracy",
      "display": "RSX FIFO accuracy",
      "type": "enum",
      "options": [
        "Fast",
        "Atomic",
        "Ordered & Atomic",
        "PS3"
      ],
      "default": "Atomic",
      "description": "How the RSX reads the command stream the Cell writes. The stricter modes see each command exactly as and when the console's would. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "delayOddMfcCommands",
      "display": "Delay each odd MFC Command",
      "type": "bool",
      "default": false,
      "description": "Holds back every other SPU DMA command so that they complete out of order, which some games depend on. rpcs3 picks the order from the CPU's time-stamp counter. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "disableSpuGetllarSpinOptimization",
      "display": "Disable SPU GETLLAR Spin Optimization",
      "type": "bool",
      "default": false,
      "description": "Stops rpcs3 from shortcutting SPUs that spin on a reservation. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "debugConsoleMode",
      "display": "Debug console mode",
      "type": "bool",
      "default": false,
      "description": "Makes the console a debug unit, with that model's larger memory, for games that need it. It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "accuratePpu128Reservations",
      "display": "Accurate PPU 128 reservations",
      "type": "int",
      "min": -1,
      "max": 14,
      "default": 0,
      "description": "How long a 128-byte PPU reservation loop may be and still be made exact: 0 never, -1 always (the wiki's 'Always Enabled'). It is part of the machine: a movie made with it replays only with it."
    },
    {
      "name": "ppuThreads",
      "display": "PPU thread count",
      "type": "int",
      "min": 1,
      "max": 8,
      "default": 2,
      "description": "How many PPU threads may run at once. The console has two hardware threads. This core pins it for determinism, and the default is that pin: the frontend drives the frames, so a change here is an experiment, and one a movie must keep."
    },
    {
      "name": "lodBiasOffset",
      "display": "LOD bias offset",
      "type": "float",
      "min": -32,
      "max": 32,
      "default": 0.0,
      "description": "Added to every texture's level-of-detail bias: negative is sharper, positive blurrier. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing."
    },
    {
      "name": "spuLoopDetection",
      "display": "Enable SPU loop detection",
      "type": "bool",
      "default": false,
      "description": "Detects SPUs waiting in a loop and yields their thread. This core pins it for determinism, and the default is that pin: the frontend drives the frames, so a change here is an experiment, and one a movie must keep."
    },
    {
      "name": "anisotropicFilter",
      "display": "Anisotropic filter",
      "type": "enum",
      "options": [
        "Auto",
        "2x",
        "4x",
        "8x",
        "16x"
      ],
      "default": "Auto",
      "description": "Overrides the game's anisotropic filtering. 'Auto' keeps the game's own. It changes what the host GPU draws, not what the console computes; with no GPU renderer it does nothing."
    },
    {
      "name": "spu_decoder",
      "display": "SPU Decoder",
      "type": "enum",
      "options": [
        "asmjit",
        "interpreter"
      ],
      "default": "asmjit",
      "description": "How the SPUs' code runs. 'asmjit' is RPCS3's ASMJIT recompiler: the same results, several times faster, and it charges the machine's clock per loop iteration and function entry. 'interpreter' charges per instruction. Both are deterministic, but they keep slightly different time, so a movie replays only with the decoder it was recorded with."
    },
    {
      "name": "ppu_decoder",
      "display": "PPU Decoder",
      "type": "enum",
      "options": [
        "interpreter",
        "llvm"
      ],
      "default": "interpreter",
      "description": "How the PPU's code runs. 'interpreter' charges the machine's clock per instruction. 'llvm' is RPCS3's LLVM recompiler: every module compiles inside the sandbox when it loads, every session (about ten seconds for the firmware's liblv2, minutes for a big game with its libraries), then runs many times faster; compiled code charges the clock per basic block. Both are deterministic, but they keep slightly different time, so a movie replays only with the decoder it was recorded with. The interpreter is the default until compiled modules can persist between sessions."
    },
    {
      "name": "port1",
      "display": "Controller 1",
      "type": "enum",
      "options": [
        "none",
        "dualshock3"
      ],
      "default": "dualshock3",
      "description": "What is plugged into controller port 1. 'dualshock3' is the DualShock 3 every PS3 shipped with, and what the game asks cellPad about; 'none' is an empty port. A port's device is part of the machine: a game asks which pads are connected, and many change their menus or player count on the answer, so two projects that differ here are two different machines and do not share movies."
    },
    {
