diff --git a/rpcs3/Emu/CMakeLists.txt b/rpcs3/Emu/CMakeLists.txt
index c0a1adf89..5ddb3ac00 100644
--- a/rpcs3/Emu/CMakeLists.txt
+++ b/rpcs3/Emu/CMakeLists.txt
@@ -728,3 +728,43 @@ endif()
 if(WAYLAND_FOUND)
     target_link_libraries(rpcs3_emu PRIVATE OpenGL::EGL)
 endif()
+
+# Chimera: the GL renderer in the box. No GLEW and no system GL: every entry
+# point is a glad pointer filled through the GPU bridge (waterbox/gl-shim.cpp).
+option(CHIMERA_GL "Chimera headless build keeps the OpenGL renderer, reached through glad and the GPU bridge" OFF)
+set(CHIMERA_GLAD_INCLUDE "" CACHE PATH "Chimera: glad's include directory for the GL renderer")
+if(CHIMERA_HEADLESS AND CHIMERA_GL)
+    target_sources(rpcs3_emu PRIVATE
+        RSX/GL/GLCommonDecompiler.cpp
+        RSX/GL/GLCompute.cpp
+        RSX/GL/GLDMA.cpp
+        RSX/GL/GLDraw.cpp
+        RSX/GL/GLFragmentProgram.cpp
+        RSX/GL/GLGSRender.cpp
+        RSX/GL/GLHelpers.cpp
+        RSX/GL/GLOverlays.cpp
+        RSX/GL/GLPipelineCompiler.cpp
+        RSX/GL/GLPresent.cpp
+        RSX/GL/GLRenderTargets.cpp
+        RSX/GL/GLResolveHelper.cpp
+        RSX/GL/GLShaderInterpreter.cpp
+        RSX/GL/GLTexture.cpp
+        RSX/GL/GLTextureCache.cpp
+        RSX/GL/glutils/blitter.cpp
+        RSX/GL/glutils/buffer_object.cpp
+        RSX/GL/glutils/capabilities.cpp
+        RSX/GL/glutils/common.cpp
+        RSX/GL/glutils/ex.cpp
+        RSX/GL/glutils/fbo.cpp
+        RSX/GL/glutils/image.cpp
+        RSX/GL/glutils/program.cpp
+        RSX/GL/glutils/ring_buffer.cpp
+        RSX/GL/glutils/sampler.cpp
+        RSX/GL/GLVertexBuffers.cpp
+        RSX/GL/GLVertexProgram.cpp
+        RSX/GL/OpenGL.cpp
+        RSX/GL/upscalers/fsr1/fsr_pass.cpp
+    )
+    target_include_directories(rpcs3_emu PRIVATE ${CHIMERA_GLAD_INCLUDE})
+    target_compile_definitions(rpcs3_emu PRIVATE CHIMERA_GL_BRIDGE)
+endif()
