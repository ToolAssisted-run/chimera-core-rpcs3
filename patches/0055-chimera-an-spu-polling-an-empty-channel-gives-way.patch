+	// poll; give way (chimera_spu_poll)
+	auto chimera_poll = [&]()
+	{
+		Label full = c->newLabel();
+		c->cmp(SPU_OFF_32(gpr, op.rt, &v128::_u32, 3), 0);
+		c->jne(full);
+		c->lea(addr->r64(), get_pc(m_pos));
+		c->and_(*addr, 0x3fffc);
+		c->mov(SPU_OFF_32(pc), *addr);
+		c->mov(*arg0, *cpu);
+		c->call(&chimera_spu_poll);
+		c->bind(full);
+	};
+#endif
+
+	auto ch_cnt = [&](x86::Mem channel_ptr, bool inv = false, bool polled = false)
 	{
