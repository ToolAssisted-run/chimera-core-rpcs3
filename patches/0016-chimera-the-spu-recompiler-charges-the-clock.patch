+#ifdef CHIMERA_CORE
+// Chimera: the budget ran out; the scheduler charges the machine's clock
+// for a slice of SPU instructions and may run other threads meanwhile
+static void chimera_spu_budget(spu_thread* _spu)
+{
+	static const bool trace = getenv("CHIMERA_SPU_TRACE") != nullptr;
+	if (trace)
+		fprintf(stderr, "[spu-budget] pc=%05x\n", _spu->pc);
+	_spu->chimera_budget += vsched_budget_slice();
+	vsched_budget_expired(VSCHED_SPU);
+}
+
+// Emit: charge the budget by n instructions and, when it runs dry, call the
+// scheduler. Only at points where the SPU state is in memory and the
+// callee-saved registers (cpu, pc0) are all the emitted code relies on.
+void spu_recompiler::chimera_charge(u32 n)
+{
+	using namespace asmjit;
+	if (!n)
+		return;
+	Label ok = c->newLabel();
+	c->sub(SPU_OFF_64(chimera_budget), n);
+	c->jg(ok);
+	c->mov(*arg0, *cpu);
+	c->call(&chimera_spu_budget);
+	c->bind(ok);
+}
+#endif
